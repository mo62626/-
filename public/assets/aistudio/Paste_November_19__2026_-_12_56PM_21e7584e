    }

    function renderSwotPane(mode) {
      if (mode === "matrix") return `<div class="grid-2"><div class="card em"><span class="pill-tag en" style="background:var(--em-s);color:var(--em)">S • Strengths</span><h3>نقاط القوة الجوهرية</h3><p style="margin:0">• <strong>تكلفة منخفضة وعائد مرتفع (<span class="en">ROI</span>):</strong> استثمار الخيال والتكنولوجيا بدلاً من الميزانيات الضخمة.<br/>• <strong>كسر العمى الإعلاني:</strong> المفاجأة تجبر الدماغ على التركيز.<br/>• <strong>انتشار فيروسي مجاني:</strong> الجمهور يصور وينشر التجربة طوعاً.<br/>• <strong>مرونة وسرعة فائقة:</strong> إطلاق وتعديل الحملات خلال ساعات.</p></div><div class="card red"><span class="pill-tag en">W • Weaknesses</span><h3>نقاط الضعف والتحديات</h3><p style="margin:0">• <strong>صعوبة القياس في الشارع الصرف:</strong> صعوبة تتبع المبيعات دون ربط رقمي.<br/>• <strong>قِصر عمر المفاجأة:</strong> تفقد الفكرة عنصر الصدمة بمجرد اعتياد الناس عليها.<br/>• <strong>الاعتماد الكلي على جودة الفكرة:</strong> الفكرة الضعيفة تفشل دون ميزانية تغطيها.<br/>• <strong>احتمال نسيان اسم العلامة:</strong> إذا لم تُطبَّق قاعدة الـ 3 ثوانٍ بوضوح.</p></div><div class="card sky"><span class="pill-tag en" style="background:var(--sky-s);color:var(--sky)">O • Opportunities</span><h3>الفرص المتاحة في السوق</h3><p style="margin:0">• <strong>انتشار الهواتف ومنصات الفيديو القصير:</strong> كل مارٍّ يحمل كاميرا قادرة على صناعة تريند.<br/>• <strong>تقنيات الواقع المعزز (<span class="en">WebAR</span>) والجرافيك (<span class="en">FOOH</span>):</strong> تنفيذ أفكار مدهشة بتكلفة بسيطة.<br/>• <strong>التكامل مع التسويق بالعمولة:</strong> ربط الشارع بعمولات قابلة للقياس عبر <span class="en">QR</span>.</p></div><div class="card amb"><span class="pill-tag en" style="background:var(--amb-s);color:var(--amb)">T • Threats</span><h3>التهديدات والمخاطر الخارجية</h3><p style="margin:0">• <strong>القيود القانونية والتصاريح البلدية:</strong> إزالة المجسمات أو فرض غرامات دون موافقات مسبقة.<br/>• <strong>خطر إثارة الذعر الأمني:</strong> كما حدث في كارثة بوسطن عام 2007.<br/>• <strong>التقليد السريع من المنافسين:</strong> استنساخ الفكرة من شركات أكبر.</p></div></div>`;
      if (mode === "strengths") return `<div class="grid-2"><div class="note-box" style="background:#fff;border-color:var(--em)"><strong>1. استغلال التكلفة المنخفضة ← التجارب السريعة (<span class="en">A/B Testing</span>):</strong><br/>تقسيم الميزانية الصغيرة إلى 3 تجارب رقمية/ميدانية مصغرة، ثم ضخ ميزانية الترويج في التجربة الأعلى تفاعلاً.</div><div class="note-box" style="background:#fff;border-color:var(--em)"><strong>2. استغلال كسر العمى الإعلاني ← دعوة فورية للفعل (<span class="en">CTA</span>):</strong><br/>في اللحظة الذهبية التي يتوقف فيها عقل المستهلك مندهشاً، نضع أمامه خطوة بسيطة ومغرية (مسح رمز QR للحصول على خصم فوري).</div><div class="note-box" style="background:#fff;border-color:var(--em)"><strong>3. استغلال القابلية للانتشار ← هندسة زاوية التصوير (<span class="en">Selfie-Ready</span>):</strong><br/>تصميم تجربة الواقع المعزز بإضاءة ممتازة وزاوية يظهر فيها شعار المطعم أو الفندق في خلفية كل فيديو يلتقطه الزبون.</div><div class="note-box" style="background:#fff;border-color:var(--em)"><strong>4. استغلال المرونة والسرعة ← ركوب الأحداث اللحظية (<span class="en">Newsjacking</span>):</strong><br/>تنفيذ فكرة غوريلا خلال 24 ساعة فقط بالتزامن مع موسم الدراسة أو المباريات الكبرى في المنصورة.</div></div>`;
      return `<div class="grid-2"><div class="note-box" style="background:#fff"><strong>علاج الضعف 1 (صعوبة القياس) ← الربط بأكواد <span class="en">QR</span> والتتبع (<span class="en">UTM</span>):</strong><br/>عدم إطلاق أي حملة صامتة؛ ربط كل بطاقة أو مجسم برمز QR وكود خصم حصري لقياس المبيعات الناتجة بدقة 100%.</div><div class="note-box" style="background:#fff"><strong>علاج الضعف 2 (قِصر عمر المفاجأة) ← التوثيق وإعادة التدوير:</strong><br/>تصوير ردود فعل الجمهور الحقيقية أثناء تجربة الواقع المعزز، ثم تحويل الفيديو إلى إعلانات ممولة مستمرة لشهور.</div><div class="note-box" style="background:#fff"><strong>علاج الضعف 3 (نسيان اسم العلامة) ← دمج المنتج في صلب الفكرة:</strong><br/>جعل الوجبة نفسها أو غرفة الفندق هي بطل تجربة الـ 3D بحيث يستحيل تذكّر الفكرة دون العلامة.</div><div class="note-box" style="background:#fff"><strong>علاج الضعف 4 (المخاطر القانونية) ← البدائل الرقمية والنظيفة:</strong><br/>استخدام الواقع المعزز عبر الهاتف <span class="en">WebAR</span> وفيديوهات <span class="en">FOOH</span> الرقمية دون إشغال الأرصفة أو مخالفة القوانين.</div></div>`;
    }
    function pickSwot(mode, btn) { btn.parentElement.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active")); btn.classList.add("active"); document.getElementById("swotArea").innerHTML = renderSwotPane(mode); }

    function renderEndPane(tab) {
      if (tab === "risks") return `<div class="grid-2"><div class="card red"><span class="pill-tag">كارثة موثقة • 31 يناير 2007 • بوسطن، أمريكا</span><h3>حادثة حملة <span class="en">Aqua Teen Hunger Force</span> في بوسطن</h3><p>زرع فريق تسويق شبكة <strong class="en">Turner Broadcasting</strong> 38 لوحة إلكترونية مضيئة بأسلاك مكشوفة أسفل الجسور وفي محطات مترو بوسطن دون إخطار السلطات.</p><div class="note-box"><strong>النتيجة الكارثية بالأرقام:</strong> ظن السكان والشرطة أنها قنابل بدائية الصنع، فأُغلقت الجسور ومحطات المترو واستُدعيت فرق المتفجرات، ودفعَت الشركة تعويضاً بقيمة <strong>2 مليون دولار أمريكي</strong> لمدينة بوسطن واستقال رئيس الشبكة!</div></div><div class="card sky" style="padding:12px">${renderFigure(25, "compact")}<span class="pill-tag" style="background:var(--sky-s);color:var(--sky)">الخطوط الحمراء القانونية</span><h3>قواعد الأمان القانوني والأخلاقي</h3><p style="margin:0;font-size:.81rem"><strong>1. عدم إثارة الذعر الأمني:</strong> تجنب أي مجسمات غامضة أو أجهزة متروكة.<br/><strong>2. التصاريح البلدية:</strong> الحصول على الموافقات الرسمية عند استخدام الشوارع.<br/><strong>3. حماية الممتلكات والبيئة:</strong> عدم تشويه الجدران بالدهانات الدائمة.<br/><strong>4. احترام الخصوصية والشفافية:</strong> عدم تصوير الأفراد دون موافقة.</p></div></div>`;
      if (tab === "glossary") return `<div style="margin-bottom:8px"><input type="text" id="gSearch" class="ppt-input" style="max-width:340px" placeholder="🔍 ابحث في الـ 28 مصطلحاً..." oninput="filterG()" /></div><div class="grid-2" id="gList" style="max-height:335px;overflow-y:auto;padding-left:4px">${glossaryData.map(g => `<div class="card red" style="padding:10px 12px"><span class="pill-tag en">${g.en}</span><h3 style="font-size:.90rem">${g.ar}</h3><p style="font-size:.79rem;margin-bottom:4px"><strong>التعريف:</strong> ${g.def}</p><div class="note-box" style="padding:5px 8px;font-size:.77rem;margin-top:4px">${g.mean}</div></div>`).join("")}</div>`;
      return `<div style="max-height:375px;overflow-y:auto;display:flex;flex-direction:column;gap:5px;padding-left:4px">
        <div class="note-box" style="margin:0;background:#fff"><strong>1.</strong> <span class="en">Jay Conrad Levinson (1984) — <em>Guerrilla Marketing: Secrets for Making Big Profits from Your Small Business</em>, Houghton Mifflin, Boston.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>2.</strong> <span class="en">Jay Conrad Levinson &amp; Seth Godin (1994) — <em>The Guerrilla Marketing Handbook</em>, Houghton Mifflin, Boston.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>3.</strong> <span class="en">Jay Conrad Levinson &amp; Paul R. J. Hanley (2005) — <em>The Guerrilla Marketing Revolution</em>, Piatkus Books, London.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>4.</strong> <span class="en">Adam Morgan (1999) — <em>Eating the Big Fish: How Challenger Brands Can Compete Against Brand Leaders</em>, John Wiley &amp; Sons.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>5.</strong> <span class="en">Jonah Berger (2013) — <em>Contagious: Why Things Catch On</em>, Simon &amp; Schuster, New York.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>6.</strong> <span class="en">Emanuel Rosen (2000) — <em>The Anatomy of Buzz: How to Create Word-of-Mouth Marketing</em>, Doubleday, New York.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>7.</strong> <span class="en">Katharina Hutter &amp; Stefan Hoffmann (2011) — "Guerrilla Marketing: The Nature of the Concept", <em>Asian Journal of Marketing</em>, 5(2), 39–54.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>8.</strong> <span class="en">Katharina Hutter &amp; Stefan Hoffmann (2014) — "Surprise, Surprise. Ambient Media as Promotion Tool", <em>Journal of Retailing</em>, 90(1), 93–110.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>9.</strong> <span class="en">Sandra Luxton &amp; Lachlan Drummond (2000) — "What is this thing called 'Ambient Advertising'?", <em>ANZMAC Proceedings</em>, 734–738.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>10.</strong> <span class="en">Bettina Cornwell &amp; Isabelle Maignan (1998) — "An International Review of Sponsorship Research", <em>Journal of Advertising</em>, 27(1), 1–21.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>11.</strong> <span class="en">Philip Kotler, Hermawan Kartajaya, &amp; Iwan Setiawan (2017) — <em>Marketing 4.0: Moving from Traditional to Digital</em>, Wiley.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>12.</strong> <span class="en">Philip Kotler, Hermawan Kartajaya, &amp; Iwan Setiawan (2021) — <em>Marketing 5.0: Technology for Humanity</em>, Wiley.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>13.</strong> <span class="en">Evgeniy Prussakov (2007) — <em>A Practical Guide to Affiliate Marketing</em>, Llumina Press, Austin, TX.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>14.</strong> <span class="en">Shawn Collins (2008) — <em>Successful Affiliate Marketing for Merchants</em>, Que Publishing / Pearson Education.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>15.</strong> <span class="en">Charles Esdaile (2004) — <em>Fighting Napoleon: Guerrillas, Bandits and Adventurers in Spain, 1808–1814</em>, Yale University Press.</span></div>
        <div class="note-box" style="margin:0;background:#fff"><strong>16.</strong> <span class="en">Carl von Clausewitz (1832) — <em>On War (Vom Kriege)</em>, Ferdinand Dümmler, Berlin.</span></div>
      </div>`;
    }
    function pickEndTab(tab, btn) { btn.parentElement.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active")); btn.classList.add("active"); document.getElementById("endArea").innerHTML = renderEndPane(tab); }
    function filterG() {
      const q = (document.getElementById("gSearch")?.value || "").toLowerCase().trim();
      const filtered = glossaryData.filter(g => g.en.toLowerCase().includes(q) || g.ar.includes(q) || g.def.includes(q) || g.mean.includes(q));
      document.getElementById("gList").innerHTML = filtered.map(g => `<div class="card red" style="padding:10px 12px"><span class="pill-tag en">${g.en}</span><h3 style="font-size:.90rem">${g.ar}</h3><p style="font-size:.79rem;margin-bottom:4px"><strong>التعريف:</strong> ${g.def}</p><div class="note-box" style="padding:5px 8px;font-size:.77rem;margin-top:4px">${g.mean}</div></div>`).join("");
    }

    /* =========================================================================
       6. PRESENTATION ENGINE & FULLSCREEN VIDEO OPENER CONTROLS
       ========================================================================= */
    let currentSlide = 0;

    function startOpenerVideo() {
      const v = document.getElementById("fullscreenIntroVideo");
      const btn = document.getElementById("unmuteOpenerBtn");
      if (!v) return;
      v.currentTime = 0;
      v.muted = false;
      const playPromise = v.play();
      if (playPromise !== undefined) {
        playPromise.then(() => {
          if (btn) btn.textContent = "🔇 كتم الصوت";
        }).catch(() => {
          v.muted = true;
          v.play().catch(() => {});
          if (btn) btn.textContent = "🔊 تشغيل الصوت";
        });
      }
    }

    function toggleOpenerAudio() {
      const v = document.getElementById("fullscreenIntroVideo");
      const btn = document.getElementById("unmuteOpenerBtn");
      if (!v) return;
      v.muted = !v.muted;
      if (v.paused) v.play().catch(() => {});
      if (btn) btn.textContent = v.muted ? "🔊 تشغيل الصوت" : "🔇 كتم الصوت";
    }

    function finishIntroVideo() {
      const stage = document.getElementById("videoOpenerStage");
      const v = document.getElementById("fullscreenIntroVideo");
      if (v) v.pause();
      if (stage) stage.classList.add("hidden");
    }

    function replayOpenerVideo() {
      const stage = document.getElementById("videoOpenerStage");
      const splash = document.getElementById("introSplash");
      if (splash) splash.classList.remove("hidden");
      if (stage) stage.classList.remove("hidden");
      startOpenerVideo();
    }

    function enterPresentation() {
      finishIntroVideo();
      const splash = document.getElementById("introSplash");
      if (splash) splash.classList.add("hidden");
      renderSlide(0);
    }

    function renderSlide(idx) {
      if (idx < 0) idx = 0;
      if (idx >= slides.length) idx = slides.length - 1;
      currentSlide = idx;
      const s = slides[idx];
      const wrap = document.getElementById("slideContentWrap");
      wrap.classList.remove("slide-enter");
      void wrap.offsetWidth;
      wrap.classList.add("slide-enter");
      wrap.innerHTML = `
        <header class="s-header">
          <div>
            <div class="s-kicker">${s.kicker}</div>
            <h1 class="s-title">${s.title}</h1>
            <p class="s-subtitle">${s.subtitle}</p>
          </div>
          <div class="s-badge-en">${s.badge}</div>
        </header>
        <div class="s-body">${s.render()}</div>
      `;
      document.getElementById("dockCounter").textContent = `${pad2(idx + 1)} / ${pad2(slides.length)}`;
      document.getElementById("pptBar").style.width = `${((idx + 1) / slides.length) * 100}%`;

      if (s.num === 14) {
        setTimeout(runAffiliateApp, 30);
      }
    }

    function nextSlide() { if (currentSlide < slides.length - 1) renderSlide(currentSlide + 1); }
    function prevSlide() { if (currentSlide > 0) renderSlide(currentSlide - 1); }

    function toggleSorter() {
      const modal = document.getElementById("sorterModal");
      const open = modal.classList.toggle("open");
      if (open) {
        document.getElementById("sorterGrid").innerHTML = slides.map((s, i) => `
          <div class="sorter-card ${i === currentSlide ? 'active' : ''}" onclick="renderSlide(${i});toggleSorter()">
            <div class="sorter-thumb"><img src="${getBaseName(s.img)}.jpg" data-try-idx="0" onerror="handleLocalImgError(this, ${s.img})" alt="" /></div>
            <div style="font-family:var(--fh);font-size:.77rem;font-weight:700;color:var(--red)">${pad2(s.num)} • ${s.short}</div>
          </div>
        `).join("");
      }
    }

    function toggleFullscreen() {
      if (!document.fullscreenElement) document.documentElement.requestFullscreen?.().catch(() => {});
      else document.exitFullscreen?.().catch(() => {});
    }

    document.addEventListener("keydown", (e) => {
      if (["INPUT", "SELECT", "TEXTAREA"].includes(document.activeElement?.tagName)) return;
      if (e.key === "ArrowLeft") nextSlide();
      else if (e.key === "ArrowRight") prevSlide();
      else if (e.key === "Escape") document.getElementById("sorterModal").classList.remove("open");
    });

    window.addEventListener("DOMContentLoaded", () => {
      renderSlide(0);
      startOpenerVideo();
    });
  </script>
</body>
</html>