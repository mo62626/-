<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>عرض تقديمي احترافي | التسويق الغوريلا (Guerrilla Marketing)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@600;700;800;900&family=Outfit:wght@500;600;700;800&family=Readex+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --red: #dc2626;
      --red-b: #ef4444;
      --red-s: rgba(220, 38, 38, 0.10);
      --sky: #0284c7;
      --sky-s: rgba(14, 165, 233, 0.12);
      --ind: #4f46e5;
      --ind-s: rgba(79, 70, 229, 0.11);
      --amb: #d97706;
      --amb-s: rgba(245, 158, 11, 0.13);
      --em: #059669;
      --em-s: rgba(16, 185, 129, 0.12);
      --ink: #0f172a;
      --body: #334155;
      --fh: 'Alexandria', sans-serif;
      --fb: 'Readex Pro', sans-serif;
      --fe: 'Outfit', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      width: 100%; height: 100vh; overflow: hidden;
      font-family: var(--fb); color: var(--ink);
      background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 55%, #fef2f2 100%);
      -webkit-font-smoothing: antialiased;
    }

    .en { font-family: var(--fe); font-weight: 600; direction: ltr; unicode-bidi: embed; }

    /* STAGE 1: FULLSCREEN OPENING VIDEO (NO CIRCLE) */
    .video-opener-stage {
      position: fixed; inset: 0; z-index: 6000;
      width: 100vw; height: 100vh; background: #070a12;
      display: flex; align-items: center; justify-content: center;
      transition: opacity 0.55s ease, visibility 0.55s;
    }
    .video-opener-stage.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
    .video-opener-stage video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .video-controls-bar {
      position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
      z-index: 6010; display: flex; align-items: center; gap: 12px;
      background: rgba(15, 23, 42, 0.82); backdrop-filter: blur(10px);
      padding: 10px 20px; border-radius: 999px;
      border: 1.5px solid rgba(255, 255, 255, 0.25);
    }
    .v-btn {
      background: rgba(255, 255, 255, 0.14); color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.35);
      padding: 8px 18px; border-radius: 999px;
      font-family: var(--fh); font-size: 0.84rem; font-weight: 700;
      cursor: pointer; transition: all 0.2s ease; white-space: nowrap;
    }
    .v-btn:hover { background: rgba(255, 255, 255, 0.28); }
    .v-btn.primary { background: var(--red); border-color: var(--red); box-shadow: 0 6px 20px rgba(220, 38, 38, 0.45); }

    /* STAGE 2: START COVER */
    .intro-splash {
      position: fixed; inset: 0; z-index: 5000;
      background: radial-gradient(circle at 50% 42%, rgba(239, 68, 68, 0.16), transparent 58%), linear-gradient(135deg, #ffffff 0%, #f8fafc 55%, #fef2f2 100%);
      display: flex; align-items: center; justify-content: center; padding: 20px;
      transition: opacity 0.45s ease, transform 0.45s ease, visibility 0.45s;
    }
    .intro-splash.hidden { opacity: 0; transform: scale(1.03); visibility: hidden; pointer-events: none; }

    /* ANIMATED RED & WHITE BORDER */
    .intro-card, .slide-frame-outer {
      position: relative; border-radius: 28px; padding: 6px; overflow: hidden; background: #ffffff;
      box-shadow: 0 18px 50px rgba(220, 38, 38, 0.20), 0 8px 24px rgba(15, 23, 42, 0.09);
    }
    .intro-card { width: 100%; max-width: 820px; }
    .intro-card::before, .slide-frame-outer::before {
      content: ""; position: absolute; top: -65%; left: -65%; width: 230%; height: 230%;
      background: conic-gradient(from 0deg, #ffffff 0deg, #ffffff 55deg, #ef4444 95deg, #dc2626 145deg, #ffffff 180deg, #ffffff 235deg, #ef4444 275deg, #dc2626 325deg, #ffffff 360deg);
      animation: spinFrame 4s linear infinite; z-index: 0;
    }
    @keyframes spinFrame { to { transform: rotate(360deg); } }

    .intro-inner {
      position: relative; z-index: 1; background: rgba(255, 255, 255, 0.98);
      border-radius: 22px; padding: 36px 32px; text-align: center;
      display: flex; flex-direction: column; align-items: center;
    }

    .intro-badge, .s-kicker, .pill-tag {
      display: inline-block; background: var(--red-s); color: var(--red);
      font-family: var(--fh); font-weight: 700; font-size: 0.74rem;
      padding: 4px 13px; border-radius: 999px; margin-bottom: 8px;
    }
    .pill-tag { border-radius: 8px; font-size: 0.71rem; }

    .intro-title { font-family: var(--fh); font-size: clamp(1.7rem, 3vw, 2.4rem); font-weight: 900; line-height: 1.3; margin-bottom: 12px; }
    .intro-sub { font-size: 0.95rem; color: var(--body); max-width: 650px; line-height: 1.75; margin-bottom: 24px; }

    .enter-btn {
      background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
      color: #ffffff; border: none; padding: 14px 38px; border-radius: 999px;
      font-family: var(--fh); font-size: 1.04rem; font-weight: 800; cursor: pointer;
      box-shadow: 0 12px 28px rgba(220, 38, 38, 0.34); transition: transform 0.2s ease;
    }
    .enter-btn:hover { transform: translateY(-2px); }

    /* VIEWPORT & SLIDES */
    .ppt-progress { position: fixed; top: 0; left: 0; right: 0; height: 5px; background: rgba(220, 38, 38, 0.14); z-index: 2000; }
    .ppt-progress-bar { height: 100%; width: 5.88%; background: linear-gradient(90deg, #dc2626, #ef4444, #dc2626); transition: width 0.35s ease; }

    .viewport { width: 100vw; height: 100vh; padding: 14px 22px 64px; display: flex; align-items: center; justify-content: center; }
    .slide-frame-outer { width: 100%; max-width: 1460px; height: 100%; display: flex; }

    .slide-canvas {
      position: relative; z-index: 1; width: 100%; height: 100%;
      background: #ffffff; border-radius: 22px;
      padding: 18px 26px; display: flex; flex-direction: column; overflow: hidden;
    }

    .slide-bg-layer {
      position: absolute; inset: 0; z-index: 0;
      background-image: url('BG-SLIDE.jpg'), url('BG-SLIDE.png'), url('BG-SLIDE.webp');
      background-size: cover; background-position: center;
      opacity: 0.42; pointer-events: none; overflow: hidden;
    }
    .slide-bg-layer video { width: 100%; height: 100%; object-fit: cover; display: block; }

    .slide-content-wrap { position: relative; z-index: 1; width: 100%; height: 100%; display: flex; flex-direction: column; overflow: hidden; }
    .slide-enter { animation: slideIn 0.35s ease; }
    @keyframes slideIn { from { opacity: 0.72; transform: translateY(7px); } to { opacity: 1; transform: translateY(0); } }

    .s-header {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 14px;
      margin-bottom: 11px; border-bottom: 2px solid rgba(220, 38, 38, 0.18); flex-shrink: 0;
      background: rgba(255, 255, 255, 0.88); backdrop-filter: blur(5px); border-radius: 12px; padding: 7px 12px 9px;
    }
    .s-title { font-family: var(--fh); font-size: clamp(1.12rem, 1.75vw, 1.62rem); font-weight: 800; line-height: 1.35; }
    .s-subtitle { font-size: 0.84rem; color: var(--body); margin-top: 2px; line-height: 1.56; }
    .s-badge-en {
      background: rgba(255, 255, 255, 0.96); border: 1.5px solid rgba(220, 38, 38, 0.32); color: var(--red);
      padding: 5px 12px; border-radius: 10px; font-family: var(--fe); font-size: 0.71rem; font-weight: 700; white-space: nowrap;
    }

    .s-body { flex: 1; overflow-y: auto; padding-left: 6px; scrollbar-width: thin; scrollbar-color: rgba(220, 38, 38, 0.35) transparent; }
    .s-body::-webkit-scrollbar { width: 5px; }
    .s-body::-webkit-scrollbar-thumb { background: rgba(220, 38, 38, 0.4); border-radius: 10px; }

    .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 13px; }
    @media (max-width: 1024px) { .grid-3 { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 768px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } .slide-canvas { padding: 14px; } }

    .card {
      background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(6px);
      border: 1px solid rgba(148, 163, 184, 0.32);
      border-radius: 16px; padding: 13px 15px; box-shadow: 0 5px 16px rgba(15, 23, 42, 0.05);
    }
    .card.red { border-top: 4px solid var(--red-b); }
    .card.sky { border-top: 4px solid #0ea5e9; }
    .card.ind { border-top: 4px solid var(--ind); }
    .card.amb { border-top: 4px solid #f59e0b; }
    .card.em { border-top: 4px solid #10b981; }

    .card h3 { font-family: var(--fh); font-size: 0.93rem; font-weight: 700; margin-bottom: 5px; line-height: 1.4; }
    .card p { font-size: 0.82rem; color: var(--body); line-height: 1.64; margin-bottom: 6px; }

    .note-box { background: rgba(254, 242, 242, 0.95); border-right: 3.5px solid var(--red-b); padding: 8px 11px; border-radius: 10px; font-size: 0.79rem; line-height: 1.58; margin-top: 6px; }
    .note-box strong { color: var(--red); font-family: var(--fh); }

    /* PURE CLEAN IMAGE FRAME (NO CAPTIONS / NO LABELS BELOW) */
    .visual-figure { width: 100%; border-radius: 13px; overflow: hidden; margin-bottom: 9px; border: 1.5px solid #e2e8f0; background: #f8fafc; }
    .visual-frame { position: relative; width: 100%; height: 158px; overflow: hidden; }
    .visual-figure.tall .visual-frame { height: 285px; }
    .visual-figure.compact .visual-frame { height: 120px; }
    .visual-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .xray-dot {
      position: absolute; width: 26px; height: 26px; border-radius: 50%;
      background: var(--red); color: #fff; font-weight: 800; font-size: 0.78rem;
      display: flex; align-items: center; justify-content: center; cursor: pointer;
      border: 2px solid #fff; box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.35); z-index: 3;
    }

    /* TABLES, TABS & CONTROLS */
    .ppt-table { width: 100%; border-collapse: collapse; font-size: 0.79rem; background: rgba(255,255,255,0.96); border-radius: 11px; overflow: hidden; border: 1px solid #e2e8f0; }
    .ppt-table th { background: var(--red-s); color: var(--red); font-family: var(--fh); padding: 7px 10px; text-align: right; }
    .ppt-table td { padding: 6px 10px; border-bottom: 1px solid #f1f5f9; color: var(--body); line-height: 1.48; }

    .tab-row { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 10px; }
    .tab-btn { background: rgba(255,255,255,0.95); border: 1px solid #cbd5e1; color: var(--body); padding: 6px 13px; border-radius: 999px; font-family: var(--fh); font-weight: 600; font-size: 0.76rem; cursor: pointer; }
    .tab-btn.active, .tab-btn:hover { background: var(--red); color: #fff; border-color: var(--red); }

    .ppt-input, .ppt-select { width: 100%; padding: 8px 10px; border-radius: 9px; border: 1.5px solid #cbd5e1; background: #fff; font-family: var(--fb); font-size: 0.82rem; }
    .action-btn { background: var(--red); color: #fff; border: none; padding: 8px 14px; border-radius: 9px; font-family: var(--fh); font-size: 0.79rem; font-weight: 700; cursor: pointer; transition: background 0.2s; }
    .action-btn:hover { background: #b91c1c; }
    .action-btn.sec { background: var(--ink); }

    /* PRESENTER DOCK */
    .ppt-dock {
      position: fixed; bottom: 10px; left: 50%; transform: translateX(-50%); z-index: 2500;
      background: rgba(255, 255, 255, 0.97); border: 2px solid var(--red-b);
      box-shadow: 0 10px 26px rgba(220, 38, 38, 0.18); border-radius: 999px;
      padding: 5px 14px; display: flex; align-items: center; gap: 7px; max-width: 96vw;
    }
    .dock-btn { background: transparent; border: none; color: var(--ink); padding: 6px 11px; border-radius: 999px; font-family: var(--fh); font-size: 0.76rem; font-weight: 700; cursor: pointer; white-space: nowrap; }
    .dock-btn:hover { background: var(--red-s); color: var(--red); }
    .dock-btn.primary { background: var(--red); color: #fff; }
    .dock-counter { font-family: var(--fe); font-weight: 800; font-size: 0.84rem; color: var(--red); padding: 0 7px; cursor: pointer; }

    .modal-overlay { position: fixed; inset: 0; z-index: 4000; background: rgba(15, 23, 42, 0.72); backdrop-filter: blur(8px); display: none; align-items: center; justify-content: center; padding: 20px; }
    .modal-overlay.open { display: flex; }
    .modal-box { width: 100%; max-width: 1240px; max-height: 88vh; background: #fff; border: 3px solid var(--red-b); border-radius: 22px; padding: 22px; display: flex; flex-direction: column; overflow: hidden; }
    .sorter-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 11px; overflow-y: auto; padding: 5px; margin-top: 12px; }
    @media (max-width: 900px) { .sorter-grid { grid-template-columns: repeat(2, 1fr); } }
    .sorter-card { background: #f8fafc; border: 2px solid transparent; border-radius: 13px; padding: 9px; cursor: pointer; }
    .sorter-card:hover, .sorter-card.active { border-color: var(--red); background: #fef2f2; }
    .sorter-thumb { width: 100%; height: 64px; border-radius: 8px; overflow: hidden; margin-bottom: 5px; background: #e2e8f0; }
    .sorter-thumb img { width: 100%; height: 100%; object-fit: cover; }
  </style>
</head>
<body>

  <!-- STAGE 1: FULLSCREEN OPENING VIDEO (NO CIRCLE) -->
  <div class="video-opener-stage" id="videoOpenerStage">
    <video id="fullscreenIntroVideo" src="LOGO-INTRO.mp4" playsinline onended="finishIntroVideo()" onerror="finishIntroVideo()"></video>
    <div class="video-controls-bar">
      <button class="v-btn" id="unmuteOpenerBtn" onclick="toggleOpenerAudio()">🔊 تشغيل الصوت</button>
      <button class="v-btn primary" onclick="finishIntroVideo()">تخطي إلى بدء العرض ←</button>
    </div>
  </div>

  <!-- STAGE 2: START COVER -->
  <div class="intro-splash" id="introSplash">
    <div class="intro-card">
      <div class="intro-inner">
        <div class="intro-badge">عرض تقديمي أكاديمي وتطبيقي متكامل • 17 شريحة</div>
        <h1 class="intro-title">التسويق الغوريلا (<span class="en">Guerrilla Marketing</span>)</h1>
        <p class="intro-sub">
          مرجع شامل ومرتب في 5 محاور: الجذور التاريخية، الأبعاد السياقية الستة، المزيج السباعي، دراسات الحالة العالمية بالأرقام، التقنيات الحديثة وخطوات صناعة الواقع المعزز (<span class="en">WebAR</span>) خطوة بخطوة، برنامج توليد <span class="en">QR</span> التسويق بالعمولة، والتطبيق العملي في مدينة المنصورة.
        </p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
          <button class="enter-btn" onclick="enterPresentation()">ابدأ تقديم البريزنتيشن ←</button>
          <button class="v-btn" style="color:var(--ink);border-color:#cbd5e1;background:#f8fafc" onclick="replayOpenerVideo()">🎬 إعادة الفيديو الافتتاحي</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Top Progress Bar -->
  <div class="ppt-progress"><div class="ppt-progress-bar" id="pptBar"></div></div>

  <!-- Main Presentation Viewport -->
  <main class="viewport">
    <div class="slide-frame-outer">
      <section class="slide-canvas" id="slideCanvas">
        <div class="slide-bg-layer">
          <video id="bgLoopVideo" src="BG-SLIDE.mp4" autoplay loop muted playsinline onerror="this.style.display='none'"></video>
        </div>
        <div class="slide-content-wrap" id="slideContentWrap"></div>
      </section>
    </div>
  </main>

  <!-- Presenter Navigation Dock -->
  <nav class="ppt-dock" aria-label="التحكم في العرض">
    <button class="dock-btn" onclick="prevSlide()">→ السابق</button>
    <span class="dock-counter" id="dockCounter" onclick="toggleSorter()">01 / 17</span>
    <button class="dock-btn primary" onclick="nextSlide()">التالي ←</button>
    <span style="width:1px; height:18px; background:#cbd5e1;"></span>
    <button class="dock-btn" onclick="replayOpenerVideo()">🎬 الافتتاحية</button>
    <button class="dock-btn" onclick="toggleSorter()">⊞ كل الشرائح (17)</button>
    <button class="dock-btn" onclick="toggleFullscreen()">⛶ ملء الشاشة</button>
  </nav>

  <!-- Slide Sorter Modal -->
  <div class="modal-overlay" id="sorterModal" onclick="if(event.target.id==='sorterModal') toggleSorter()">
    <div class="modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2 style="font-family:var(--fh); font-size:1.08rem;">⊞ خريطة الشرائح الكاملة المرتبة (17 شريحة • <span class="en">Slide Sorter</span>)</h2>
        <button class="dock-btn primary" onclick="toggleSorter()">✕ إغلاق</button>
      </div>
      <div class="sorter-grid" id="sorterGrid"></div>
    </div>
  </div>

  <script>
    /* =========================================================================
       1. REAL ISO/IEC 18004 QR CODE GENERATOR (100% SCANNABLE BY ANY PHONE)
       ========================================================================= */
    const QRGen = (() => {
      const EXP = new Uint8Array(512), LOG = new Uint8Array(256);
      let x = 1;
      for (let i = 0; i < 255; i++) {
        EXP[i] = x; LOG[x] = i;
        x <<= 1; if (x & 0x100) x ^= 0x11d;
      }
      for (let i = 255; i < 512; i++) EXP[i] = EXP[i - 255];

      function gfMul(a, b) { return (a === 0 || b === 0) ? 0 : EXP[LOG[a] + LOG[b]]; }
      function rsGenPoly(deg) {
        let p = [1];
        for (let i = 0; i < deg; i++) {
          const next = new Array(p.length + 1).fill(0);
          for (let j = 0; j < p.length; j++) { next[j] ^= p[j]; next[j + 1] ^= gfMul(p[j], EXP[i]); }
          p = next;
        }
        return p;
      }
      function rsEncode(data, eccLen) {
        const gen = rsGenPoly(eccLen);
        const res = new Uint8Array(data.length + eccLen);
        res.set(data);
        for (let i = 0; i < data.length; i++) {
          const coef = res[i];
          if (coef !== 0) for (let j = 0; j < gen.length; j++) res[i + j] ^= gfMul(gen[j], coef);
        }
        return res.slice(data.length);
      }

      const VERS = [
        null,
        [1, 21, 19, 7, 1, [], 0],
        [2, 25, 34, 10, 1, [6, 18], 0],
        [3, 29, 55, 15, 1, [6, 22], 0],
        [4, 33, 80, 20, 1, [6, 26], 0],
        [5, 37, 108, 26, 1, [6, 30], 0],
        [6, 41, 136, 18, 2, [6, 34], 0],
        [7, 45, 156, 20, 2, [6, 22, 38], 0x07c94],
        [8, 49, 194, 24, 2, [6, 24, 42], 0x085bc]
      ];

      function drawToCanvas(canvas, text) {
        if (!canvas) return;
        const bytes = new TextEncoder().encode(text);
        let v = 1;
        while (v <= 8 && VERS[v][2] < bytes.length + 2) v++;
        if (v > 8) v = 8;
        const [, size, totalData, eccLen, blocks, align, verBits] = VERS[v];
        const payload = bytes.slice(0, totalData - 2);

        const bits = [];
        const pushBits = (val, len) => { for (let i = len - 1; i >= 0; i--) bits.push((val >> i) & 1); };
        pushBits(0b0100, 4); pushBits(payload.length, 8);
        payload.forEach(b => pushBits(b, 8));
        pushBits(0, Math.min(4, totalData * 8 - bits.length));
        while (bits.length % 8 !== 0) bits.push(0);
        const dataBytes = [];
        for (let i = 0; i < bits.length; i += 8) {
          let b = 0; for (let j = 0; j < 8; j++) b = (b << 1) | bits[i + j];
          dataBytes.push(b);
        }
        const pads = [0xec, 0x11]; let pi = 0;
        while (dataBytes.length < totalData) { dataBytes.push(pads[pi % 2]); pi++; }

        const bSize = Math.floor(totalData / blocks);
        const dBlocks = [], eBlocks = [];
        for (let b = 0; b < blocks; b++) {
          const slice = new Uint8Array(dataBytes.slice(b * bSize, (b + 1) * bSize));
          dBlocks.push(slice); eBlocks.push(rsEncode(slice, eccLen));
        }
        const finalBytes = [];
        for (let i = 0; i < bSize; i++) for (let b = 0; b < blocks; b++) finalBytes.push(dBlocks[b][i]);
        for (let i = 0; i < eccLen; i++) for (let b = 0; b < blocks; b++) finalBytes.push(eBlocks[b][i]);

        const M = Array.from({ length: size }, () => new Uint8Array(size));
        const setF = (r, c, dark) => { if (r >= 0 && r < size && c >= 0 && c < size) M[r][c] = dark ? 2 : 1; };
        const finder = (r0, c0) => {
          for (let r = -1; r <= 7; r++) for (let c = -1; c <= 7; c++) {
            const dark = (r >= 0 && r <= 6 && c >= 0 && c <= 6) && (r === 0 || r === 6 || c === 0 || c === 6 || (r >= 2 && r <= 4 && c >= 2 && c <= 4));
            setF(r0 + r, c0 + c, dark);
          }
        };
        finder(0, 0); finder(0, size - 7); finder(size - 7, 0);
        for (let i = 8; i < size - 8; i++) { setF(6, i, i % 2 === 0); setF(i, 6, i % 2 === 0); }
        for (const r of align) for (const c of align) {
          if (M[r][c] !== 0) continue;
          for (let dr = -2; dr <= 2; dr++) for (let dc = -2; dc <= 2; dc++) setF(r + dr, c + dc, Math.abs(dr) === 2 || Math.abs(dc) === 2 || (dr === 0 && dc === 0));
        }
        for (let i = 0; i < 9; i++) { if (M[8][i] === 0) M[8][i] = 1; if (M[i][8] === 0) M[i][8] = 1; }
