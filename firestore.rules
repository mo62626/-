rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidPresentationRating(data) {
      return data.keys().hasAll([
        'authorId',
        'authorName',
        'authorRole',
        'rating',
        'sentiment',
        'comment',
        'isPublic',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'authorId',
        'authorName',
        'authorRole',
        'rating',
        'sentiment',
        'comment',
        'isPublic',
        'createdAt',
        'updatedAt'
      ])
      && data.authorId is string
      && isValidId(data.authorId)
      && data.authorId == request.auth.uid
      && data.authorName is string
      && data.authorName.size() >= 1
      && data.authorName.size() <= 60
      && data.authorRole is string
      && data.authorRole.size() >= 1
      && data.authorRole.size() <= 40
      && data.rating is int
      && data.rating >= 1
      && data.rating <= 5
      && data.sentiment is string
      && data.sentiment in ['excellent', 'good', 'needs_improvement']
      && data.comment is string
      && data.comment.size() <= 400
      && data.isPublic is bool
      && data.isPublic == true
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /presentation_ratings/{ratingId} {
      allow get: if isValidId(ratingId) && existing().isPublic == true;
      allow list: if resource.data.isPublic == true;

      allow create: if isVerifiedUser()
        && isValidId(ratingId)
        && ratingId == request.auth.uid
        && isValidPresentationRating(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(ratingId)
        && ratingId == request.auth.uid
        && isValidPresentationRating(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().isPublic == existing().isPublic
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'authorName',
          'authorRole',
          'rating',
          'sentiment',
          'comment',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser()
        && isValidId(ratingId)
        && ratingId == request.auth.uid;
    }
  }
}
